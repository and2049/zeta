{
  // Copy into ~/.config/zeta/zeta.jsonc or <project>/.zeta/zeta.jsonc.
  "model": "openai/gpt-4.1",
  "provider": {
    "openai": { "options": { "apiKey": "{env:OPENAI_API_KEY}" } }
  },
  // Settings for the example permissions extension (see permissions.md).
  "plugin": {
    "permissions": {
      "rules": [{ "tool": "bash", "pattern": "*", "effect": "ask" }]
    }
  }
}
