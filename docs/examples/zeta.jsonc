{
  // Copy into ~/.config/zeta/zeta.jsonc or <project>/.zeta/zeta.jsonc.
  "model": "example/model",
  "provider": {
    "example": { "options": { "baseURL": "https://example.invalid/v1", "apiKey": "{env:MODEL_API_KEY}" } }
  },
  "permission": [
    { "action": "external_directory", "pattern": "*", "effect": "ask" }
  ]
}
